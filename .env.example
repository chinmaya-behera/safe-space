# Paths are relative to this project directory. No database password is needed.
DATABASE_PATH=./data/safe-space.sqlite
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
SESSION_DAYS=7
# For deployment behind exactly one trusted reverse proxy, set this to 1.
TRUST_PROXY_HOPS=0
